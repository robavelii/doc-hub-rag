# Doc-Hub on the host's shared Caddy, installed as /etc/caddy/sites/doc-hub.caddy by
# scripts/deploy_oci.sh. Caddy holds 80/443 for every app on the machine; this file
# is the only thing Doc-Hub owns there. Ports match docker-compose.prod.yml.
#
# doc.rfh.et: an A record, DNS only (not proxied by Cloudflare), so Caddy gets a public
# certificate and its X-Forwarded-For carries the real visitor IP for per-visitor
# widget rate limits. If the record is ever proxied, add `tls internal` (Cloudflare SSL
# mode for rfh.et is "full") and take the visitor IP from CF-Connecting-IP instead.

doc.rfh.et {
	encode zstd gzip

	request_body {
		max_size 50MB
	}

	# Prometheus metrics stay private (scrape on 127.0.0.1:8100/metrics). A handle block,
	# not a bare respond: handle/handle_path run before respond, and the longer path
	# sorts ahead of /api/*.
	handle /api/metrics* {
		respond 404
	}

	# API. handle_path strips /api, as the dashboard and widget expect.
	# Server-sent events (/query/stream) are flushed immediately by Caddy.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8100
	}

	redir /app /app/
	handle_path /app/* {
		reverse_proxy 127.0.0.1:8102
	}

	handle_path /widget/* {
		reverse_proxy 127.0.0.1:8103
	}

	handle {
		reverse_proxy 127.0.0.1:8101
	}

	log {
		output file /var/log/caddy/doc-hub.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
