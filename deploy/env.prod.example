# Production environment for docker-compose.prod.yml. Lives on the server as
# /opt/doc-hub/.env.prod (chmod 600). scripts/deploy_oci.sh --init-env writes one
# with generated secrets; fill in the AI keys afterwards. Never commit the real file.

APP_ENV=production
APP_BASE_URL=https://doc.rfh.et/api
DASHBOARD_URL=https://doc.rfh.et/app
CORS_ORIGINS=https://doc.rfh.et
VITE_DASHBOARD_URL=/app/

# Database: the app connects as app_user (RLS enforced); migrations as postgres.
POSTGRES_PASSWORD=__GENERATE__
DATABASE_APP_PASSWORD=__GENERATE_APP__
DATABASE_URL=postgresql+asyncpg://app_user:__GENERATE_APP__@postgres:5432/ragdb
DATABASE_SYNC_URL=postgresql://app_user:__GENERATE_APP__@postgres:5432/ragdb
DATABASE_MIGRATE_URL=postgresql://postgres:__GENERATE__@postgres:5432/ragdb

REDIS_PASSWORD=__GENERATE_REDIS__
REDIS_URL=redis://:__GENERATE_REDIS__@redis:6379/0

S3_ACCESS_KEY=doc-hub
S3_SECRET_KEY=__GENERATE_S3__
S3_BUCKET=rag-documents
S3_REGION=us-east-1

JWT_SECRET=__GENERATE_JWT__
ENCRYPTION_KEY=__GENERATE_FERNET__
SUPERADMIN_EMAIL=admin@rfh.et
SUPERADMIN_PASSWORD=__GENERATE_ADMIN__

# --- AI -------------------------------------------------------------------
# Embeddings stay local (in-process bge-small, 384 dims): no API cost, and
# switching the chat provider below never requires re-indexing documents.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384
RERANKER=local

# Chat: tried in order, first configured one that answers wins.
# Values: openai | gemini | compatible | ollama | mock
CHAT_PROVIDER_CHAIN=gemini,compatible,openai,mock
AI_PROVIDER=gemini
PROVIDER_TIMEOUT_SECONDS=60

OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini

# AI Studio key. 2.5 models are closed to new keys. Thinking tokens count against
# the answer budget: "none" turns thinking off on 3.5-flash.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_REASONING_EFFORT=none

# Any other OpenAI-compatible API (OpenRouter, Groq, DeepSeek, Anthropic, …).
# Production uses this slot as a Gemini fallback for "high demand" errors on the
# primary model: same endpoint and key, the lite model (which needs effort >= low).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_CHAT_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low

ENABLE_QUERY_REWRITE=false

# --- Optional integrations --------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=https://doc.rfh.et/app/settings?billing=success
STRIPE_CANCEL_URL=https://doc.rfh.et/app/settings?billing=cancel
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SENTRY_DSN=

# SSO (docker compose --profile sso). Leave POLIS_URL empty to disable.
POLIS_URL=
POLIS_PUBLIC_URL=
POLIS_API_KEY=
POLIS_CLIENT_SECRET_VERIFIER=
POLIS_WEBHOOK_SECRET=
POLIS_NEXTAUTH_SECRET=
POLIS_DB_ENCRYPTION_KEY=
