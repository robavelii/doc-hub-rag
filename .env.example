# Database (use app_user after running migration 004; postgres only for migrations)
DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev_password@localhost:5432/ragdb
DATABASE_SYNC_URL=postgresql://app_user:app_user_dev_password@localhost:5432/ragdb
DATABASE_APP_PASSWORD=app_user_dev_password
DATABASE_ADMIN_URL=
DATABASE_ADMIN_SYNC_URL=
POSTGRES_PASSWORD=postgres

# Redis
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://:redis_dev_password@localhost:6379/0

# AI Provider (mock | openai | ollama). Embeddings: mock | openai | ollama | local
AI_PROVIDER=mock
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Local Ollama (small models, CPU-friendly)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Chat providers tried in order: openai | gemini | compatible | ollama | mock
CHAT_PROVIDER_CHAIN=openai,ollama,mock
OPENAI_BASE_URL=
# Gemini via its OpenAI-compatible endpoint (AI Studio key). "none" disables thinking,
# which otherwise spends the answer's token budget (3.5-flash; -lite needs "low").
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_REASONING_EFFORT=none
# Any other OpenAI-compatible API (OpenRouter, Groq, DeepSeek, Anthropic, vLLM…)
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_REASONING_EFFORT=
# Exactly one embedding provider is used; there is no fallback (vectors from
# different models cannot be mixed). Empty = follow AI_PROVIDER.
# local = in-process bge-small (384 dims, no API key): set EMBEDDING_DIMENSIONS=384.
EMBEDDING_PROVIDER=
EMBEDDING_DIMENSIONS=768
# Reranker for retrieved chunks: none | local (in-process cross-encoder)
RERANKER=local
PROVIDER_TIMEOUT_SECONDS=90

# S3-compatible storage (SeaweedFS in compose; any S3 works)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1

# Auth
JWT_SECRET=change-this-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
ENCRYPTION_KEY=change-this-32-byte-key-for-fernet

# App
APP_ENV=development
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080
SUPERADMIN_EMAIL=admin@yoursaas.com
SUPERADMIN_PASSWORD=change-this

# Notion (optional)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=http://localhost:3000/settings?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/settings?billing=cancel

# Observability
SENTRY_DSN=
ENABLE_QUERY_REWRITE=false

# Enterprise SSO + SCIM via self-hosted Ory Polis (docker compose --profile sso).
# Leave POLIS_URL empty to disable SSO. Create the "polis" database first.
POLIS_URL=
POLIS_PUBLIC_URL=
POLIS_API_KEY=
POLIS_CLIENT_SECRET_VERIFIER=
POLIS_WEBHOOK_SECRET=
POLIS_NEXTAUTH_SECRET=
POLIS_DB_ENCRYPTION_KEY=
# Public URLs: the API (SSO callback + SCIM webhook) and the dashboard (post-login redirect)
APP_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000
