# Database (use app_user after running migration 004; postgres only for migrations)
DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev_password@localhost:5432/ragdb
DATABASE_SYNC_URL=postgresql://app_user:app_user_dev_password@localhost:5432/ragdb
DATABASE_APP_PASSWORD=app_user_dev_password
DATABASE_ADMIN_URL=
DATABASE_ADMIN_SYNC_URL=
POSTGRES_PASSWORD=postgres

# Redis
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://:redis_dev_password@localhost:6379/0

# AI Provider (mock | openai | ollama)
AI_PROVIDER=mock
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Local Ollama (small models, CPU-friendly)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHAT_PROVIDER_CHAIN=openai,ollama,mock
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSIONS=768
PROVIDER_TIMEOUT_SECONDS=90

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1

# Auth
JWT_SECRET=change-this-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
ENCRYPTION_KEY=change-this-32-byte-key-for-fernet

# App
APP_ENV=development
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080
SUPERADMIN_EMAIL=admin@yoursaas.com
SUPERADMIN_PASSWORD=change-this

# Notion (optional)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=http://localhost:3000/settings?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/settings?billing=cancel

# Observability
SENTRY_DSN=
ENABLE_QUERY_REWRITE=false
